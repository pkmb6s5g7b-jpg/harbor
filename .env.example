# Site URL used in Stripe success/cancel redirects (optional in local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe TEST keys (Dashboard → Developers → API keys)
# Never commit live keys. Never prefix the secret with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs from Dashboard (Products) or `node scripts/create-stripe-products.mjs`
STRIPE_PRICE_DEBT=price_REPLACE_ME
STRIPE_PRICE_PAYCHECK=price_REPLACE_ME
STRIPE_PRICE_CASHFLOW=price_REPLACE_ME
STRIPE_PRICE_BUNDLE=price_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_SELLER=price_REPLACE_ME
STRIPE_PRICE_RECONCILE=price_REPLACE_ME
STRIPE_PRICE_PROJECT=price_REPLACE_ME

# Optional — send calculator snapshots (Resend)
# RESEND_API_KEY=re_...
# RESULTS_FROM_EMAIL=Harbor <hello@getharborplans.com>
